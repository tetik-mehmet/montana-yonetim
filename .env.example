# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=membership_db

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Secret (Production'da güçlü bir secret kullanın!)
SESSION_SECRET=your-secret-key-change-this-in-production

# CORS Configuration (virgülle ayırarak birden fazla domain ekleyebilirsiniz)
# Örnek: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://your-render-app.onrender.com
